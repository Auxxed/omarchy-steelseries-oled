{
  "schemaVersion": 1,
  "id": "io.github.auxxed.steelseries-oled",
  "name": "SteelSeries OLED",
  "version": "1.2.0",
  "author": "auxxed",
  "license": "MIT",
  "homepage": "https://github.com/auxxed/omarchy-steelseries-oled",
  "description": "Loops the Omarchy wordmark on SteelSeries Apex OLED keyboards (Apex 7, Pro, and 5).",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "OledBarWidget.qml"
  },
  "barWidget": {
    "displayName": "SteelSeries OLED",
    "description": "Omarchy wordmark on Apex OLED keyboards",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
